#!/bin/sh
# qlaude — Claude Code against your own endpoint, no env-var literacy.
# Strict POSIX sh (spec C1): shellcheck -s sh clean, dash -n clean.
# Never eval config contents (spec §6); no set -x anywhere (spec §6).
set -u

QLAUDE_VERSION=0.0.1

# --- paths: canonical definitions per spec §0 — every use means exactly this
# shellcheck disable=SC2034  # read by the test suites; constants are the API
QLAUDE_INSTALLDIR_RESOLVED=${QLAUDE_INSTALL_DIR:-$HOME/.local/bin}
# shellcheck disable=SC2034  # read by the test suites; constants are the API
QLAUDE_CONFDIR_RESOLVED=${QLAUDE_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/qlaude}

# --- exit codes: centralized per the spec §5.5 gauntlet table. All are part
# of the contract used by doctor/setup paths (T4-T6), not dead today.
# shellcheck disable=SC2034  # used by later tasks per spec §5.5 exit map
EXIT_USAGE=1
EXIT_PREREQ=2
# shellcheck disable=SC2034  # spec §5.5 step-1 exit (auth failures)
EXIT_AUTH=3
# shellcheck disable=SC2034  # spec §5.5 step-2 exit (claude failures)
EXIT_CLI=4
# shellcheck disable=SC2034  # spec §5.5 step-3 exit (tool-probe failures)
EXIT_TOOL=5

# --- output discipline (spec C9): diagnostics on stderr only, plain when
# NO_COLOR / TERM=dumb / non-TTY. NO_COLOR is honoured on PRESENCE, not
# value (no-color.org, the baseline C9 cites): NO_COLOR= must also silence.
if [ "${NO_COLOR+set}" = set ] || [ "${TERM:-}" = dumb ] || [ ! -t 2 ]; then
    C_ERR=''
else
    C_ERR=$(printf '\033[31m')
fi
C_RESET=''
if [ -z "$C_ERR" ]; then
    :
else
    C_RESET=$(printf '\033[0m')
fi

err() {
    printf '%s%sqlaude: %s%s\n' "$C_ERR" '' "$*" "$C_RESET" >&2
}

usage() {
    cat <<'USAGE'
usage: qlaude [command] [args...]

Commands:
  (none)         launch Claude Code against the configured endpoint
  setup          guided configuration (interview + self-test)
  doctor         run the self-test gauntlet
  config         show resolved configuration (never the token)
  ensure-path    add the install dir to PATH (consent-based)
  --version      print version
  --help         this text
USAGE
}

# config_parse <file> — config is data, never code: KEY=value lines read with
# read/case (spec §5.2, never eval'd; spec §6). Populates QLAUDE_* honoring
# precedence flags > QLAUDE_* env > file > default. Corrupted config gets a
# fix message pointing at qlaude setup, never a crash.
config_parse() {
    if [ "$#" -ne 1 ]; then
        err "internal: config_parse needs one file argument"
        return "$EXIT_USAGE"
    fi
    _file=$1
    if [ ! -f "$_file" ]; then
        err "no config at $_file — run: qlaude setup"
        return "$EXIT_USAGE"
    fi

    _ep='' _md='' _au='' _ct='' _ef='' _cb='' _tk='' _n=0
    # Never echo the offending line: a corrupted line may itself carry the
    # token (spec §6, G4) — report the line number only.
    while IFS= read -r _line || [ -n "$_line" ]; do
        _n=$((_n + 1))
        case $_line in
            '' | '#'*) continue ;;
        esac
        case $_line in
            *=*) ;;
            *)
                err "config corrupted (line $_n is not KEY=value) — run: qlaude setup"
                return "$EXIT_USAGE"
                ;;
        esac
        _key=${_line%%=*}
        case $_key in
            '' | *[!A-Z0-9_]*)
                err "config corrupted (line $_n is not KEY=value) — run: qlaude setup"
                return "$EXIT_USAGE"
                ;;
        esac
        _val=${_line#*=}
        case $_key in
            QLAUDE_ENDPOINT) _ep=$_val ;;
            QLAUDE_MODEL) _md=$_val ;;
            QLAUDE_AUTH) _au=$_val ;;
            QLAUDE_CONTEXT_TOKENS) _ct=$_val ;;
            QLAUDE_EFFORT) _ef=$_val ;;
            QLAUDE_CLAUDE_BIN) _cb=$_val ;;
            QLAUDE_TOKEN) _tk=$_val ;;
            *) : ;; # unknown but well-formed keys are forward-compatible
        esac
    done <"$_file"

    # precedence: an already-set (non-empty) QLAUDE_* env beats the file
    if [ -z "${QLAUDE_ENDPOINT:-}" ]; then QLAUDE_ENDPOINT=$_ep; fi
    if [ -z "${QLAUDE_MODEL:-}" ]; then QLAUDE_MODEL=$_md; fi
    if [ -z "${QLAUDE_AUTH:-}" ]; then QLAUDE_AUTH=$_au; fi
    if [ -z "${QLAUDE_CONTEXT_TOKENS:-}" ]; then QLAUDE_CONTEXT_TOKENS=$_ct; fi
    if [ -z "${QLAUDE_EFFORT:-}" ]; then QLAUDE_EFFORT=$_ef; fi
    if [ -z "${QLAUDE_CLAUDE_BIN:-}" ]; then QLAUDE_CLAUDE_BIN=$_cb; fi
    if [ -z "${QLAUDE_TOKEN:-}" ]; then QLAUDE_TOKEN=$_tk; fi

    case $QLAUDE_AUTH in
        '' | bearer | api-key) ;;
        *)
            err "config corrupted (invalid QLAUDE_AUTH value) — run: qlaude setup"
            return "$EXIT_USAGE"
            ;;
    esac
    QLAUDE_AUTH=${QLAUDE_AUTH:-bearer}
    QLAUDE_CONTEXT_TOKENS=${QLAUDE_CONTEXT_TOKENS:-262144}
    QLAUDE_EFFORT=${QLAUDE_EFFORT:-medium}

    if [ -z "$QLAUDE_ENDPOINT" ]; then
        err "QLAUDE_ENDPOINT missing — run: qlaude setup"
        return "$EXIT_USAGE"
    fi
    case $QLAUDE_ENDPOINT in
        */v1)
            err "warning: stripped trailing /v1 from endpoint — Claude Code appends /v1/messages itself (see README Setup block)"
            QLAUDE_ENDPOINT=${QLAUDE_ENDPOINT%/v1}
            ;;
    esac
    if [ -z "$QLAUDE_MODEL" ]; then
        err "QLAUDE_MODEL missing — run: qlaude setup"
        return "$EXIT_USAGE"
    fi
    return 0
}

# Command bodies not yet built are dispatch placeholders (T5 gauntlet,
# T6 ensure-path + full config).
not_implemented() {
    err "'$1' is not available in this build yet — see the qlaude issue tracker for its task"
    return "$EXIT_PREREQ"
}

cmd_doctor() { not_implemented doctor; }
cmd_ensure_path() { not_implemented ensure-path; }

# --- wizard (spec §5.4)
usage_setup() {
    cat <<'USAGE'
usage: qlaude setup [-y] [--endpoint U] [--model M] [--auth A] [--context N] \
                    [--effort E] [--claude-bin P] [--token-stdin]
USAGE
}

# T5 replaces this with the real step functions; setup must pass its exit
# code through (§5.4). The placeholder keeps that contract honest meanwhile.
run_gauntlet() { return 0; }

# probe_models <endpoint> <token> — GET /v1/models WITH the auth header over
# curl stdin config (token never argv, C6); echoes space-joined ids on
# success, returns non-zero when unreachable.
probe_models() {
    _pout=$(curl -s -m 5 --config - <<EOF
url = "$1/v1/models"
header = "anthropic-version: 2023-06-01"
header = "Authorization: Bearer $2"
write-out = "%{http_code}"
silent
EOF
) || return 1
    case $_pout in
        *200)
            # tolerant of whitespace the server puts around ':'
            # Server-controlled ids are stripped to printable ASCII before
            # any display: a hostile endpoint must not inject terminal
            # escape sequences into the user's terminal (security review).
            printf '%s\n' "${_pout%200}" | \
                grep -o '"id"[[:space:]]*:[[:space:]]*"[^"]*"' | \
                sed 's/.*"\([^"]*\)"$/\1/' | tr '\n' ' ' | \
                LC_ALL=C tr -cd '\040-\176'
            ;;
        *) return 1 ;;
    esac
}

cmd_setup() {
    _y='' _ep=${QLAUDE_ENDPOINT:-} _md=${QLAUDE_MODEL:-} _au=${QLAUDE_AUTH:-}
    _ct=${QLAUDE_CONTEXT_TOKENS:-} _ef=${QLAUDE_EFFORT:-} _cb=${QLAUDE_CLAUDE_BIN:-}
    _tok=${QLAUDE_TOKEN:-} _tok_stdin=''
    while [ $# -gt 0 ]; do
        case $1 in
            -y) _y=1 ;;
            --endpoint) shift; _ep=${1:-} ;;
            --model) shift; _md=${1:-} ;;
            --auth) shift; _au=${1:-} ;;
            --context) shift; _ct=${1:-} ;;
            --effort) shift; _ef=${1:-} ;;
            --claude-bin) shift; _cb=${1:-} ;;
            --token-stdin) _tok_stdin=1 ;;
            *)
                err "unknown option '$1'"
                usage_setup >&2
                return 1
                ;;
        esac
        shift
    done

    _cf="$QLAUDE_CONFDIR_RESOLVED/config.env"
    # Re-setup: preview existing values; unflagged answers keep them (§5.4).
    # The token value is never previewed (A4).
    if [ -f "$_cf" ]; then
        while IFS= read -r _line || [ -n "$_line" ]; do
            case $_line in
                QLAUDE_ENDPOINT=*)
                    if [ -z "$_ep" ]; then _ep=${_line#*=}; err "preview: keeping QLAUDE_ENDPOINT=$_ep"; fi
                    ;;
                QLAUDE_MODEL=*)
                    if [ -z "$_md" ]; then _md=${_line#*=}; err "preview: keeping QLAUDE_MODEL=$_md"; fi
                    ;;
                QLAUDE_AUTH=*) [ -z "$_au" ] && _au=${_line#*=} ;;
                QLAUDE_CONTEXT_TOKENS=*) [ -z "$_ct" ] && _ct=${_line#*=} ;;
                QLAUDE_EFFORT=*) [ -z "$_ef" ] && _ef=${_line#*=} ;;
                QLAUDE_CLAUDE_BIN=*) [ -z "$_cb" ] && _cb=${_line#*=} ;;
                QLAUDE_TOKEN=*) [ -z "$_tok" ] && _tok=${_line#*=} ;;
            esac
        done <"$_cf"
    fi

    # claude present? detect-then-offer, never silent, never silent-install.
    _cb=${_cb:-claude}
    if ! command -v "$_cb" >/dev/null 2>&1; then
        err "claude bin '$_cb' not found — install Claude Code (official: npm install -g @anthropic-ai/claude-code) or pass --claude-bin"
    fi

    # token FIRST (before any probe), never echoed (C9): stdin flag or prompt.
    if [ -n "$_tok_stdin" ]; then
        IFS= read -r _tok || _tok=''
    fi
    if [ -z "$_tok" ] && [ -t 0 ]; then
        err "token (input hidden): "
        # spec §5.4 mandates read -rs (silent); undefined per strict POSIX,
        # but dash/bash/macOS sh all implement it and this branch is TTY-only.
        # shellcheck disable=SC3045
        IFS= read -rs _tok || _tok=''
    fi
    if [ -z "$_tok" ]; then
        err "no token (use --token-stdin or QLAUDE_TOKEN) — setup needs it before the model probe"
        usage_setup >&2
        return 1
    fi

    # endpoint; then the authed model probe (token in hand first, §5.4).
    if [ -z "$_ep" ]; then
        if [ ! -t 0 ] || [ -n "$_y" ]; then
            err "endpoint required (--endpoint or QLAUDE_ENDPOINT)"
            usage_setup >&2
            return 1
        fi
        err "endpoint URL: "
        IFS= read -r _ep || _ep=''
    fi
    # echoed endpoint is printable-ASCII filtered too: an env-inherited
    # QLAUDE_ENDPOINT is as untrusted as the server's answer.
    _epd=$(printf '%s' "$_ep" | LC_ALL=C tr -cd '\040-\176')
    _ids=$(probe_models "$_ep" "$_tok") && [ -n "$_ids" ] || _ids=''
    if [ -n "$_ids" ]; then
        err "discovered models from $_epd/v1/models: $_ids"
    else
        err "note: model probe unreachable at $_epd/v1/models — supply --model"
    fi
    if [ -z "$_md" ]; then
        if [ ! -t 0 ] || [ -n "$_y" ]; then
            err "model required (--model or QLAUDE_MODEL)"
            usage_setup >&2
            return 1
        fi
        err "model: "
        IFS= read -r _md || _md=''
    fi

    # auth: bearer only (§5.2 / C7).
    _au=${_au:-bearer}
    case $_au in
        bearer) ;;
        *)
            err "auth style must be bearer (C7: api-key headers fail vLLM account checks)"
            return 1
            ;;
    esac

    if [ -z "$_ct" ]; then
        if [ -n "$_y" ]; then
            err "warning: --context not set — verify it against your server's max-model-len; defaulting to 262144"
        fi
        _ct=262144
    fi
    _ef=${_ef:-medium}

    # save 0600, atomic (temp + mv, §5.4)
    if ! mkdir -p "$QLAUDE_CONFDIR_RESOLVED"; then
        err "cannot create $QLAUDE_CONFDIR_RESOLVED"
        return "$EXIT_PREREQ"
    fi
    _t="$_cf.tmp.$$"
    : >"$_t" || return "$EXIT_PREREQ"
    chmod 600 "$_t"
    if {
        printf 'QLAUDE_ENDPOINT=%s\n' "$_ep"
        printf 'QLAUDE_MODEL=%s\n' "$_md"
        printf 'QLAUDE_AUTH=%s\n' "$_au"
        printf 'QLAUDE_CONTEXT_TOKENS=%s\n' "$_ct"
        printf 'QLAUDE_EFFORT=%s\n' "$_ef"
        printf 'QLAUDE_CLAUDE_BIN=%s\n' "$_cb"
        printf 'QLAUDE_TOKEN=%s\n' "$_tok"
    } >"$_t" && mv "$_t" "$_cf"; then
        err "saved $_cf (token stored, value not printed)"
    else
        rm -f "$_t"
        err "could not write $_cf"
        return "$EXIT_PREREQ"
    fi

    # tail: run the gauntlet, pass its exit code through (§5.4)
    run_gauntlet
}

# --- launcher (spec §5.3)
# The export set is the contract (A4): exactly these, no more.
# shellcheck disable=SC2034  # the set is the spec §5.3 contract, read below
QLAUDE_EXPORTS='ANTHROPIC_BASE_URL ANTHROPIC_AUTH_TOKEN ANTHROPIC_MODEL ANTHROPIC_DEFAULT_OPUS_MODEL ANTHROPIC_DEFAULT_SONNET_MODEL ANTHROPIC_DEFAULT_HAIKU_MODEL CLAUDE_CODE_AUTO_MODE_MODEL CLAUDE_CODE_BG_CLASSIFIER_MODEL CLAUDE_CODE_EFFORT_LEVEL CLAUDE_CODE_MAX_CONTEXT_TOKENS'

# abs_exec <path-or-name> — echo an absolute executable path. A value with
# a slash is resolved against the CWD and absolutized (a CWD-relative exec
# string would let whoever controls the directory hijack the launch).
abs_exec() {
    _c=$1
    case $_c in
        */*)
            if [ ! -x "$_c" ]; then
                return 1
            fi
            case $_c in
                /*) printf '%s\n' "$_c" ;;
                *)
                    _d=$(cd "${_c%/*}" 2>/dev/null && pwd) || return 1
                    printf '%s/%s\n' "$_d" "${_c##*/}"
                    ;;
            esac
            ;;
        *) command -v "$_c" ;;
    esac
}

# token_resolve — C6 ladder per spec §5.3 step 2: on macOS the KEYCHAIN
# comes first (security -w prints to stdout: the token is never in argv,
# only the service name); the QLAUDE_TOKEN file/env value is the fallback
# everywhere and the only source off-Darwin. Echoes the token.
token_resolve() {
    if [ "$(uname)" = Darwin ] && command -v security >/dev/null 2>&1; then
        _t=$(security find-generic-password -s qlaude -w 2>/dev/null) || _t=''
        if [ -n "$_t" ]; then
            printf '%s' "$_t"
            return 0
        fi
    fi
    if [ -n "${QLAUDE_TOKEN:-}" ]; then
        printf '%s' "$QLAUDE_TOKEN"
        return 0
    fi
    return 1
}

token_source() { # label only — never the value (A4)
    if [ "$(uname)" = Darwin ] && command -v security >/dev/null 2>&1 && \
        security find-generic-password -s qlaude -w >/dev/null 2>&1; then
        printf 'keychain'
    elif [ -n "${QLAUDE_TOKEN:-}" ]; then
        printf 'file-or-env'
    else
        printf 'unset'
    fi
}

cmd_launch() {
    _cf="$QLAUDE_CONFDIR_RESOLVED/config.env"
    if [ ! -f "$_cf" ]; then
        # §5.3 step 1: no config → go through setup, never half-launch.
        cmd_setup
        return $?
    fi
    if ! config_parse "$_cf"; then
        # config_parse already printed the doctor-style fix message (§5.3.5).
        return 1
    fi
    _tok=$(token_resolve) || {
        err "no token configured — run: qlaude setup"
        return 1
    }

    # qlaude-always-wins: unconditional exports, predictability over
    # inheritance (the README's manual block stays the bypass).
    export ANTHROPIC_BASE_URL="$QLAUDE_ENDPOINT"
    case $QLAUDE_AUTH in
        bearer)
            export ANTHROPIC_AUTH_TOKEN="$_tok"
            unset ANTHROPIC_API_KEY
            ;;
        api-key)
            export ANTHROPIC_API_KEY="$_tok"
            unset ANTHROPIC_AUTH_TOKEN
            ;;
    esac
    export ANTHROPIC_MODEL="$QLAUDE_MODEL"
    export ANTHROPIC_DEFAULT_OPUS_MODEL="$QLAUDE_MODEL"
    export ANTHROPIC_DEFAULT_SONNET_MODEL="$QLAUDE_MODEL"
    export ANTHROPIC_DEFAULT_HAIKU_MODEL="$QLAUDE_MODEL"
    export CLAUDE_CODE_AUTO_MODE_MODEL="$QLAUDE_MODEL"
    export CLAUDE_CODE_BG_CLASSIFIER_MODEL="$QLAUDE_MODEL"
    export CLAUDE_CODE_EFFORT_LEVEL="$QLAUDE_EFFORT"
    export CLAUDE_CODE_MAX_CONTEXT_TOKENS="$QLAUDE_CONTEXT_TOKENS"

    # A stale server-check kill switch must not silently defeat the pins
    # (README: this build has no local fallback).
    if [ "${CLAUDE_CODE_AUTO_MODE_SERVER:-}" = 0 ]; then
        err "warning: CLAUDE_CODE_AUTO_MODE_SERVER=0 disables server checks and this build has no local fallback — auto mode would degrade to asking approval for every checked action; unsetting it for the child (see README auto-mode section)"
        unset CLAUDE_CODE_AUTO_MODE_SERVER
    fi

    if [ "${QLAUDE_DEBUG:-}" = env ]; then
        # A4: the list itself is the assertion target; token value redacted.
        # Values come from the shell's own parameters — never an external
        # printenv, whose child would inherit the exported token (§5.3/A4).
        err "export ANTHROPIC_BASE_URL=$ANTHROPIC_BASE_URL"
        case $QLAUDE_AUTH in
            bearer) err "export ANTHROPIC_AUTH_TOKEN=[redacted]" ;;
            api-key) err "export ANTHROPIC_API_KEY=[redacted]" ;;
        esac
        err "export ANTHROPIC_MODEL=$ANTHROPIC_MODEL"
        err "export ANTHROPIC_DEFAULT_OPUS_MODEL=$ANTHROPIC_DEFAULT_OPUS_MODEL"
        err "export ANTHROPIC_DEFAULT_SONNET_MODEL=$ANTHROPIC_DEFAULT_SONNET_MODEL"
        err "export ANTHROPIC_DEFAULT_HAIKU_MODEL=$ANTHROPIC_DEFAULT_HAIKU_MODEL"
        err "export CLAUDE_CODE_AUTO_MODE_MODEL=$CLAUDE_CODE_AUTO_MODE_MODEL"
        err "export CLAUDE_CODE_BG_CLASSIFIER_MODEL=$CLAUDE_CODE_BG_CLASSIFIER_MODEL"
        err "export CLAUDE_CODE_EFFORT_LEVEL=$CLAUDE_CODE_EFFORT_LEVEL"
        err "export CLAUDE_CODE_MAX_CONTEXT_TOKENS=$CLAUDE_CODE_MAX_CONTEXT_TOKENS"
    fi

    _bin=${QLAUDE_CLAUDE_BIN:-claude}
    _abs=$(abs_exec "$_bin") || {
        err "claude bin not found ('$_bin') — install Claude Code, or set QLAUDE_CLAUDE_BIN"
        return "$EXIT_CLI"
    }
    _sp="$QLAUDE_CONFDIR_RESOLVED/SYSTEM-PROMPT.md"
    if [ -s "$_sp" ]; then
        exec "$_abs" --append-system-prompt-file "$_sp" "$@"
    fi
    err "note: no SYSTEM-PROMPT.md at $_sp — launching without the append (run: qlaude setup)"
    exec "$_abs" "$@"
}

# qlaude config — resolved state; full form lands with T6, the shadowed
# report (spec §5.3) is contract here. Never the token value (A4).
cmd_config() {
    _cf="$QLAUDE_CONFDIR_RESOLVED/config.env"
    if [ ! -f "$_cf" ]; then
        err "no config at $_cf — run: qlaude setup"
        return 1
    fi
    if ! config_parse "$_cf"; then
        return 1
    fi
    printf 'CONFDIR=%s\nINSTALLDIR=%s\nendpoint=%s\nmodel=%s\nauth=%s\ncontext=%s\neffort=%s\nclaude_bin=%s\ntoken=%s\n' \
        "$QLAUDE_CONFDIR_RESOLVED" "$QLAUDE_INSTALLDIR_RESOLVED" \
        "$QLAUDE_ENDPOINT" "$QLAUDE_MODEL" "$QLAUDE_AUTH" \
        "$QLAUDE_CONTEXT_TOKENS" "$QLAUDE_EFFORT" \
        "${QLAUDE_CLAUDE_BIN:-claude}" "$(token_source)"
    for _n in $QLAUDE_EXPORTS; do
        if [ -n "$(printenv "$_n")" ]; then
            printf 'shadowed-inherited=%s\n' "$_n"
        fi
    done
}

main() {
    _cmd=${1:-}
    case $_cmd in
        '') cmd_launch "$@" ;;
        launch)
            shift
            cmd_launch "$@"
            ;;
        --) cmd_launch "$@" ;;
        setup)
            shift
            cmd_setup "$@"
            ;;
        doctor) cmd_doctor ;;
        config) cmd_config ;;
        ensure-path) cmd_ensure_path ;;
        --version | -V) printf 'qlaude %s\n' "$QLAUDE_VERSION" ;;
        --help | -h | help) usage ;;
        *)
            err "unknown command '$_cmd'"
            usage >&2
            return "$EXIT_USAGE"
            ;;
    esac
}

# Run only as a program; sourcing this file (tests, later commands) exposes
# functions without executing main. Dispatch when invoked as qlaude, and
# also when piped (spec C5/C9 `curl ... | sh -s -- --help`): with -s there
# is no script path in $0 — POSIX leaves $0 unspecified there, and it is
# empty on dash/bash/sh here and reported as the bare shell name on some
# others — so the bare-shell names count as program invocation too. A
# sourcing caller always has its own script path in $0 and is excluded.
case $0 in
    '' | */qlaude | qlaude | sh | -sh | dash | -dash | bash | -bash)
        main "$@"
        ;;
esac
