#!/bin/sh
# qlaude — Claude Code against your own endpoint, no env-var literacy.
# Strict POSIX sh (spec C1): shellcheck -s sh clean, dash -n clean.
# Never eval config contents (spec §6); no set -x anywhere (spec §6).
set -u

QLAUDE_VERSION=0.0.1

# --- paths: canonical definitions per spec §0 — every use means exactly this
# shellcheck disable=SC2034  # read by the test suites; constants are the API
QLAUDE_INSTALLDIR_RESOLVED=${QLAUDE_INSTALL_DIR:-$HOME/.local/bin}
# shellcheck disable=SC2034  # read by the test suites; constants are the API
QLAUDE_CONFDIR_RESOLVED=${QLAUDE_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/qlaude}

# --- exit codes: centralized per the spec §5.5 gauntlet table. All are part
# of the contract used by doctor/setup paths (T4-T6), not dead today.
# shellcheck disable=SC2034  # used by later tasks per spec §5.5 exit map
EXIT_USAGE=1
EXIT_PREREQ=2
# shellcheck disable=SC2034  # spec §5.5 step-1 exit (auth failures)
EXIT_AUTH=3
# shellcheck disable=SC2034  # spec §5.5 step-2 exit (claude failures)
EXIT_CLI=4
# shellcheck disable=SC2034  # spec §5.5 step-3 exit (tool-probe failures)
EXIT_TOOL=5

# --- output discipline (spec C9): diagnostics on stderr only, plain when
# NO_COLOR / TERM=dumb / non-TTY. NO_COLOR is honoured on PRESENCE, not
# value (no-color.org, the baseline C9 cites): NO_COLOR= must also silence.
if [ "${NO_COLOR+set}" = set ] || [ "${TERM:-}" = dumb ] || [ ! -t 2 ]; then
    C_ERR=''
else
    C_ERR=$(printf '\033[31m')
fi
C_RESET=''
if [ -z "$C_ERR" ]; then
    :
else
    C_RESET=$(printf '\033[0m')
fi

err() {
    printf '%s%sqlaude: %s%s\n' "$C_ERR" '' "$*" "$C_RESET" >&2
}

usage() {
    cat <<'USAGE'
usage: qlaude [command] [args...]

Commands:
  (none)         launch Claude Code against the configured endpoint
  setup          guided configuration (interview + self-test)
  doctor         run the self-test gauntlet
  config         show resolved configuration (never the token)
  ensure-path    add the install dir to PATH (consent-based)
  --version      print version
  --help         this text
USAGE
}

# config_parse <file> — config is data, never code: KEY=value lines read with
# read/case (spec §5.2, never eval'd; spec §6). Populates QLAUDE_* honoring
# precedence flags > QLAUDE_* env > file > default. Corrupted config gets a
# fix message pointing at qlaude setup, never a crash.
config_parse() {
    if [ "$#" -ne 1 ]; then
        err "internal: config_parse needs one file argument"
        return "$EXIT_USAGE"
    fi
    _file=$1
    if [ ! -f "$_file" ]; then
        err "no config at $_file — run: qlaude setup"
        return "$EXIT_USAGE"
    fi

    _ep='' _md='' _au='' _ct='' _ef='' _cb='' _tk='' _n=0
    # Never echo the offending line: a corrupted line may itself carry the
    # token (spec §6, G4) — report the line number only.
    while IFS= read -r _line || [ -n "$_line" ]; do
        _n=$((_n + 1))
        case $_line in
            '' | '#'*) continue ;;
        esac
        case $_line in
            *=*) ;;
            *)
                err "config corrupted (line $_n is not KEY=value) — run: qlaude setup"
                return "$EXIT_USAGE"
                ;;
        esac
        _key=${_line%%=*}
        case $_key in
            '' | *[!A-Z0-9_]*)
                err "config corrupted (line $_n is not KEY=value) — run: qlaude setup"
                return "$EXIT_USAGE"
                ;;
        esac
        _val=${_line#*=}
        case $_key in
            QLAUDE_ENDPOINT) _ep=$_val ;;
            QLAUDE_MODEL) _md=$_val ;;
            QLAUDE_AUTH) _au=$_val ;;
            QLAUDE_CONTEXT_TOKENS) _ct=$_val ;;
            QLAUDE_EFFORT) _ef=$_val ;;
            QLAUDE_CLAUDE_BIN) _cb=$_val ;;
            QLAUDE_TOKEN) _tk=$_val ;;
            *) : ;; # unknown but well-formed keys are forward-compatible
        esac
    done <"$_file"

    # precedence: an already-set (non-empty) QLAUDE_* env beats the file
    if [ -z "${QLAUDE_ENDPOINT:-}" ]; then QLAUDE_ENDPOINT=$_ep; fi
    if [ -z "${QLAUDE_MODEL:-}" ]; then QLAUDE_MODEL=$_md; fi
    if [ -z "${QLAUDE_AUTH:-}" ]; then QLAUDE_AUTH=$_au; fi
    if [ -z "${QLAUDE_CONTEXT_TOKENS:-}" ]; then QLAUDE_CONTEXT_TOKENS=$_ct; fi
    if [ -z "${QLAUDE_EFFORT:-}" ]; then QLAUDE_EFFORT=$_ef; fi
    if [ -z "${QLAUDE_CLAUDE_BIN:-}" ]; then QLAUDE_CLAUDE_BIN=$_cb; fi
    if [ -z "${QLAUDE_TOKEN:-}" ]; then QLAUDE_TOKEN=$_tk; fi

    case $QLAUDE_AUTH in
        '' | bearer | api-key) ;;
        *)
            err "config corrupted (invalid QLAUDE_AUTH value) — run: qlaude setup"
            return "$EXIT_USAGE"
            ;;
    esac
    QLAUDE_AUTH=${QLAUDE_AUTH:-bearer}
    QLAUDE_CONTEXT_TOKENS=${QLAUDE_CONTEXT_TOKENS:-262144}
    QLAUDE_EFFORT=${QLAUDE_EFFORT:-medium}

    if [ -z "$QLAUDE_ENDPOINT" ]; then
        err "QLAUDE_ENDPOINT missing — run: qlaude setup"
        return "$EXIT_USAGE"
    fi
    case $QLAUDE_ENDPOINT in
        */v1)
            err "warning: stripped trailing /v1 from endpoint — Claude Code appends /v1/messages itself (see README Setup block)"
            QLAUDE_ENDPOINT=${QLAUDE_ENDPOINT%/v1}
            ;;
    esac
    if [ -z "$QLAUDE_MODEL" ]; then
        err "QLAUDE_MODEL missing — run: qlaude setup"
        return "$EXIT_USAGE"
    fi
    return 0
}

# Command bodies not yet built are dispatch placeholders (T4 wizard,
# T5 gauntlet, T6 ensure-path + full config).
not_implemented() {
    err "'$1' is not available in this build yet — see the qlaude issue tracker for its task"
    return "$EXIT_PREREQ"
}

cmd_setup() { not_implemented setup; }
cmd_doctor() { not_implemented doctor; }
cmd_ensure_path() { not_implemented ensure-path; }

# --- launcher (spec §5.3)
# The export set is the contract (A4): exactly these, no more.
# shellcheck disable=SC2034  # the set is the spec §5.3 contract, read below
QLAUDE_EXPORTS='ANTHROPIC_BASE_URL ANTHROPIC_AUTH_TOKEN ANTHROPIC_MODEL ANTHROPIC_DEFAULT_OPUS_MODEL ANTHROPIC_DEFAULT_SONNET_MODEL ANTHROPIC_DEFAULT_HAIKU_MODEL CLAUDE_CODE_AUTO_MODE_MODEL CLAUDE_CODE_BG_CLASSIFIER_MODEL CLAUDE_CODE_EFFORT_LEVEL CLAUDE_CODE_MAX_CONTEXT_TOKENS'

# token_resolve — C6 ladder: QLAUDE_TOKEN env/file beats keychain; on
# macOS the keychain is tried next (security -w prints to stdout: the token
# is never in argv, only the service name is). Echoes the token.
token_resolve() {
    if [ -n "${QLAUDE_TOKEN:-}" ]; then
        printf '%s' "$QLAUDE_TOKEN"
        return 0
    fi
    if [ "$(uname)" = Darwin ] && command -v security >/dev/null 2>&1; then
        _t=$(security find-generic-password -s qlaude -w 2>/dev/null) || return 1
        if [ -n "$_t" ]; then
            printf '%s' "$_t"
            return 0
        fi
    fi
    return 1
}

token_source() { # label only — never the value (A4)
    if [ -n "${QLAUDE_TOKEN:-}" ]; then
        printf 'file-or-env'
    elif [ "$(uname)" = Darwin ] && command -v security >/dev/null 2>&1 && \
        security find-generic-password -s qlaude -w >/dev/null 2>&1; then
        printf 'keychain'
    else
        printf 'unset'
    fi
}

cmd_launch() {
    _cf="$QLAUDE_CONFDIR_RESOLVED/config.env"
    if [ ! -f "$_cf" ]; then
        # §5.3 step 1: no config → go through setup, never half-launch.
        cmd_setup
        return $?
    fi
    if ! config_parse "$_cf"; then
        # config_parse already printed the doctor-style fix message (§5.3.5).
        return 1
    fi
    _tok=$(token_resolve) || {
        err "no token configured — run: qlaude setup"
        return 1
    }

    # qlaude-always-wins: unconditional exports, predictability over
    # inheritance (the README's manual block stays the bypass).
    export ANTHROPIC_BASE_URL="$QLAUDE_ENDPOINT"
    case $QLAUDE_AUTH in
        bearer)
            export ANTHROPIC_AUTH_TOKEN="$_tok"
            unset ANTHROPIC_API_KEY
            ;;
        api-key)
            export ANTHROPIC_API_KEY="$_tok"
            unset ANTHROPIC_AUTH_TOKEN
            ;;
    esac
    export ANTHROPIC_MODEL="$QLAUDE_MODEL"
    export ANTHROPIC_DEFAULT_OPUS_MODEL="$QLAUDE_MODEL"
    export ANTHROPIC_DEFAULT_SONNET_MODEL="$QLAUDE_MODEL"
    export ANTHROPIC_DEFAULT_HAIKU_MODEL="$QLAUDE_MODEL"
    export CLAUDE_CODE_AUTO_MODE_MODEL="$QLAUDE_MODEL"
    export CLAUDE_CODE_BG_CLASSIFIER_MODEL="$QLAUDE_MODEL"
    export CLAUDE_CODE_EFFORT_LEVEL="$QLAUDE_EFFORT"
    export CLAUDE_CODE_MAX_CONTEXT_TOKENS="$QLAUDE_CONTEXT_TOKENS"

    # A stale server-check kill switch must not silently defeat the pins
    # (README: this build has no local fallback).
    if [ "${CLAUDE_CODE_AUTO_MODE_SERVER:-}" = 0 ]; then
        err "warning: CLAUDE_CODE_AUTO_MODE_SERVER=0 disables server checks and this build has no local fallback — auto mode would degrade to asking approval for every checked action; unsetting it for the child (see README auto-mode section)"
        unset CLAUDE_CODE_AUTO_MODE_SERVER
    fi

    if [ "${QLAUDE_DEBUG:-}" = env ]; then
        # A4: the list itself is the assertion target; token value redacted.
        for _n in $QLAUDE_EXPORTS; do
            case $_n in
                ANTHROPIC_AUTH_TOKEN | ANTHROPIC_API_KEY)
                    err "export $_n=[redacted]"
                    ;;
                *)
                    err "export $_n=$(printenv "$_n")"
                    ;;
            esac
        done
    fi

    _bin=${QLAUDE_CLAUDE_BIN:-claude}
    _abs=$(command -v "$_bin") || {
        err "claude bin not found ('$_bin') — install Claude Code, or set QLAUDE_CLAUDE_BIN"
        return "$EXIT_CLI"
    }
    _sp="$QLAUDE_CONFDIR_RESOLVED/SYSTEM-PROMPT.md"
    if [ -s "$_sp" ]; then
        exec "$_abs" --append-system-prompt-file "$_sp" "$@"
    fi
    err "note: no SYSTEM-PROMPT.md at $_sp — launching without the append (run: qlaude setup)"
    exec "$_abs" "$@"
}

# qlaude config — resolved state; full form lands with T6, the shadowed
# report (spec §5.3) is contract here. Never the token value (A4).
cmd_config() {
    _cf="$QLAUDE_CONFDIR_RESOLVED/config.env"
    if [ ! -f "$_cf" ]; then
        err "no config at $_cf — run: qlaude setup"
        return 1
    fi
    if ! config_parse "$_cf"; then
        return 1
    fi
    printf 'CONFDIR=%s\nINSTALLDIR=%s\nendpoint=%s\nmodel=%s\nauth=%s\ncontext=%s\neffort=%s\nclaude_bin=%s\ntoken=%s\n' \
        "$QLAUDE_CONFDIR_RESOLVED" "$QLAUDE_INSTALLDIR_RESOLVED" \
        "$QLAUDE_ENDPOINT" "$QLAUDE_MODEL" "$QLAUDE_AUTH" \
        "$QLAUDE_CONTEXT_TOKENS" "$QLAUDE_EFFORT" \
        "${QLAUDE_CLAUDE_BIN:-claude}" "$(token_source)"
    for _n in $QLAUDE_EXPORTS; do
        if [ -n "$(printenv "$_n")" ]; then
            printf 'shadowed-inherited=%s\n' "$_n"
        fi
    done
}

main() {
    _cmd=${1:-}
    case $_cmd in
        '' | launch | --) cmd_launch "$@" ;;
        setup) cmd_setup ;;
        doctor) cmd_doctor ;;
        config) cmd_config ;;
        ensure-path) cmd_ensure_path ;;
        --version | -V) printf 'qlaude %s\n' "$QLAUDE_VERSION" ;;
        --help | -h | help) usage ;;
        *)
            err "unknown command '$_cmd'"
            usage >&2
            return "$EXIT_USAGE"
            ;;
    esac
}

# Run only as a program; sourcing this file (tests, later commands) exposes
# functions without executing main. Dispatch when invoked as qlaude, and
# also when piped (spec C5/C9 `curl ... | sh -s -- --help`): with -s there
# is no script path in $0 — POSIX leaves $0 unspecified there, and it is
# empty on dash/bash/sh here and reported as the bare shell name on some
# others — so the bare-shell names count as program invocation too. A
# sourcing caller always has its own script path in $0 and is excluded.
case $0 in
    '' | */qlaude | qlaude | sh | -sh | dash | -dash | bash | -bash)
        main "$@"
        ;;
esac
